{
  "name": "@ruliba/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "start:dev": "nest start --watch",
    "start:worker:dev": "nest start --watch --entryFile worker",
    "seed": "node dist/seed.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand --selectProjects unit",
    "test:e2e": "jest --runInBand --selectProjects e2e",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node dist/migrate.js"
  },
  "dependencies": {
    "@nestjs/common": "~11.2.8",
    "@nestjs/core": "~11.2.8",
    "@nestjs/jwt": "~11.0.2",
    "@nestjs/platform-express": "~11.2.8",
    "@nestjs/throttler": "~6.4.0",
    "@node-rs/argon2": "~2.0.2",
    "@ruliba/shared": "*",
    "@signpdf/placeholder-pdf-lib": "~4.0.0",
    "@signpdf/signer-p12": "~4.0.0",
    "@signpdf/signpdf": "~4.0.0",
    "bullmq": "~5.58.0",
    "cookie-parser": "~1.4.7",
    "drizzle-orm": "^0.45.4",
    "helmet": "~8.1.0",
    "ioredis": "~5.7.0",
    "node-forge": "~1.4.2",
    "nodemailer": "~10.3.1",
    "pdf-lib": "~1.17.1",
    "pg": "~8.23.1",
    "qrcode": "~1.5.4",
    "reflect-metadata": "~0.2.2",
    "rxjs": "~7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "~11.0.10",
    "@nestjs/testing": "~11.2.8",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.18.0",
    "@types/node-forge": "~1.3.14",
    "@types/nodemailer": "^7.0.1",
    "@types/pg": "~8.23.1",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^6.0.3",
    "drizzle-kit": "^0.31.11",
    "jest": "^30.1.3",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.1",
    "typescript": "~5.8.3"
  },
  "jest": {
    "projects": [
      {
        "displayName": "unit",
        "preset": "ts-jest",
        "testEnvironment": "node",
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$"
      },
      {
        "displayName": "e2e",
        "preset": "ts-jest",
        "testEnvironment": "node",
        "rootDir": "test",
        "testRegex": ".*\\.e2e-spec\\.ts$",
        "setupFiles": [
          "<rootDir>/setup-env.ts"
        ]
      }
    ]
  }
}
