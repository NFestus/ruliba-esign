# Settings for running eSign on a laptop or test PC with npm (npm run dev:api / dev:worker).
# Copy this file to apps/api/.env and fill in the four secrets. The app reads .env by itself.
# Make a secret:  node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# MASTER_KEY:     node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Production uses the .env in the repository root with docker compose instead (docs/deployment.md).

NODE_ENV=development
PORT=3000
APP_URL=http://localhost:5173

# Database and queue from: docker compose -f compose.dev.yml up -d
DATABASE_URL=postgresql://postgres@127.0.0.1:5433/esign
REDIS_URL=redis://localhost:6379

# How long the activation link emailed to a new user works (hours, default 72)
# ACTIVATION_TOKEN_TTL_HOURS=72
# How long a password reset link works (minutes, default 60)
# PASSWORD_RESET_TTL_MINUTES=60

# Email domains senders may use when adding a colleague as an internal signer (e.g. ruliba.com). Empty = any.
# INTERNAL_EMAIL_DOMAINS=ruliba.com

# Two-step sign-in codes by text message. "console" prints them in the worker window (development).
SMS_TRANSPORT=console
# SMS_TRANSPORT=africastalking   with AT_USERNAME, AT_API_KEY, optional AT_SENDER_ID ("sandbox" username = test environment)
# SMS_TRANSPORT=twilio           with TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_FROM

JWT_ACCESS_SECRET=
JWT_MFA_SECRET=
JWT_SIGN_SECRET=
MASTER_KEY=

# Emails go to Mailpit; read them at http://localhost:8025
EMAIL_TRANSPORT=smtp
EMAIL_FROM="Ruliba Clays eSign <sign@ruliba.com>"
SMTP_HOST=localhost
SMTP_PORT=1025

# Files are stored encrypted here. Word to PDF needs LibreOffice installed ("soffice"); use "none" to allow PDF only.
STORAGE_DIR=./data/files
CONVERTER=soffice

# First administrator, created by: npm run db:seed. You choose a new password at first sign-in.
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=
SEED_ADMIN_PASSWORD=

# Optional: mailbox that receives the nightly activity-log fingerprint
# AUDIT_ANCHOR_EMAIL=
