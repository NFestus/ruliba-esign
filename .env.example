# Ruliba Clays eSign — production settings. Copy to .env, fill every value, keep it readable by root only:
#   cp .env.example .env && chmod 600 .env
# Generate secrets with: openssl rand -base64 48   (MASTER_KEY: openssl rand -base64 32)

VERSION=0.1.0
DOMAIN=esign.ruliba.com
ACME_EMAIL=it@ruliba.com
# Leave empty for a public certificate (Let's Encrypt). Use "internal" for an intranet-only name.
TLS_MODE=

# Database (two roles: owner for migrations, app for the running service)
DB_OWNER_PASSWORD=
DB_APP_PASSWORD=
REDIS_PASSWORD=

# Sign-in tokens
JWT_ACCESS_SECRET=
JWT_MFA_SECRET=
JWT_SIGN_SECRET=
# Independent mailbox (e.g. the Finance Director) that receives the nightly activity-log fingerprint. Optional but recommended.
AUDIT_ANCHOR_EMAIL=

# Encrypts every stored file and MFA secret. LOSING THIS LOSES THE DATA.
# Keep two offline copies (docs/deployment.md, "Keys").
MASTER_KEY=

# Email: "smtp" until the ruliba.com tenant migration is done, then "graph".
EMAIL_TRANSPORT=smtp
EMAIL_FROM="Ruliba Clays eSign <sign@ruliba.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER=sign@ruliba.com

# Email domains senders may use when adding a colleague as an internal signer, comma-separated. Empty = any.
INTERNAL_EMAIL_DOMAINS=ruliba.com

# Two-step sign-in codes by text message (optional). Leave "console" to offer only authenticator apps.
# africastalking: AT_USERNAME, AT_API_KEY (AT_SENDER_ID optional). twilio: TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_FROM.
SMS_TRANSPORT=console
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# First administrator (used once by: docker compose run --rm seed). Remove after first sign-in.
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=
SEED_ADMIN_PASSWORD=

